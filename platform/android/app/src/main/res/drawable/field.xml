<?xml version="1.0" encoding="utf-8"?>
<!-- A text field: a dark inset, its frame gold while it has the focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#FF050B16" />
            <stroke android:width="1dp" android:color="@color/gold" />
            <corners android:radius="2dp" />
            <padding android:bottom="10dp" android:left="12dp" android:right="12dp" android:top="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#FF050B16" />
            <stroke android:width="1dp" android:color="@color/panel_edge" />
            <corners android:radius="2dp" />
            <padding android:bottom="10dp" android:left="12dp" android:right="12dp" android:top="10dp" />
        </shape>
    </item>
</selector>
