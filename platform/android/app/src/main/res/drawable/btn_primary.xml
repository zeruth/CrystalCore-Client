<?xml version="1.0" encoding="utf-8"?>
<!-- The one thing to press: aether blue in a gold frame, brighter when pressed, ash when not yet. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <gradient android:angle="270" android:endColor="#FF141C28" android:startColor="#FF26303F" />
            <stroke android:width="1dp" android:color="@color/gold_dim" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="270" android:endColor="#FF2C78C0" android:startColor="#FF6CC2FA" />
            <stroke android:width="1.5dp" android:color="@color/gold_text" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <gradient android:angle="270" android:endColor="#FF1B4F86" android:startColor="#FF4A9FE0" />
            <stroke android:width="2dp" android:color="@color/gold_text" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:endColor="#FF123B66" android:startColor="#FF3B8BD0" />
            <stroke android:width="1.5dp" android:color="@color/gold" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</selector>
