<?xml version="1.0" encoding="utf-8"?>
<!-- A patch's bar (and the total's): secondary progress the aether blue of what is downloaded,
     progress the gold of what is applied, over a dark groove. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="#FF050B16" />
            <stroke android:width="1dp" android:color="#FF2A3448" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item
        android:id="@android:id/secondaryProgress"
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <clip>
            <shape>
                <gradient android:angle="0" android:endColor="@color/crystal" android:startColor="@color/crystal_deep" />
                <corners android:radius="1dp" />
            </shape>
        </clip>
    </item>
    <item
        android:id="@android:id/progress"
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <clip>
            <shape>
                <gradient android:angle="0" android:endColor="@color/gold" android:startColor="@color/gold_dim" />
                <corners android:radius="1dp" />
            </shape>
        </clip>
    </item>
</layer-list>
