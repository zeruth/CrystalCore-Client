<?xml version="1.0" encoding="utf-8"?>
<!-- The progress bar: a gold-framed groove filling with aether. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="#FF050B16" />
            <stroke android:width="1dp" android:color="@color/gold_dim" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item
        android:id="@android:id/progress"
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <clip>
            <shape>
                <gradient android:angle="0" android:endColor="@color/crystal" android:startColor="@color/crystal_deep" />
                <corners android:radius="1dp" />
            </shape>
        </clip>
    </item>
</layer-list>
