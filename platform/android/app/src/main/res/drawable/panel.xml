<?xml version="1.0" encoding="utf-8"?>
<!-- A window of the launcher: dark glass, a gold rule outside, a blue one just inside it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/panel" />
            <stroke android:width="1dp" android:color="@color/gold_dim" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape>
            <stroke android:width="1dp" android:color="@color/panel_edge" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
