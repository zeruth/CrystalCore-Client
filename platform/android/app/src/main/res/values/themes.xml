<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- the launcher screens: always night, whatever the system's theme -->
    <style name="Theme.CrystalCore" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_realm</item>
        <item name="android:colorAccent">@color/crystal</item>
        <item name="android:colorControlNormal">@color/gold_dim</item>
        <item name="android:colorControlActivated">@color/gold</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:textColorHint">@color/text_dim</item>
        <item name="android:textColorHighlight">#663B8BD0</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:alertDialogTheme">@style/Theme.CrystalCore.Dialog</item>
    </style>

    <style name="Theme.CrystalCore.Dialog" parent="android:Theme.DeviceDefault.Dialog.Alert">
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:windowBackground">@drawable/panel</item>
        <item name="android:textColorPrimary">@color/gold_text</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <!-- the game: black, no bars, into the cutout -->
    <style name="Theme.CrystalCore.Game" parent="android:Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>

    <!-- ===== the launcher's type: Cinzel's carved capitals for titles, the system's for reading ===== -->
    <!-- (the root the dotted names below inherit from) -->
    <style name="CC" />

    <style name="CC.Title">
        <item name="android:fontFamily">@font/cinzel</item>
        <item name="android:textColor">@color/gold_text</item>
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:shadowColor">#CC39A0F0</item>
        <item name="android:shadowRadius">14</item>
    </style>

    <style name="CC.Subtitle">
        <item name="android:fontFamily">@font/cinzel</item>
        <item name="android:textColor">@color/crystal</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="CC.Heading">
        <item name="android:fontFamily">@font/cinzel</item>
        <item name="android:textColor">@color/gold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="CC.Body">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="CC.Small" parent="CC.Body">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="CC.Mono">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/text_mono</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="CC.Panel">
        <item name="android:background">@drawable/panel</item>
        <item name="android:padding">16dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="CC.Rule">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@drawable/rule_gold</item>
    </style>

    <style name="CC.Button" parent="android:Widget.DeviceDefault.Button.Borderless">
        <item name="android:fontFamily">@font/cinzel</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="CC.Button.Primary">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="android:shadowColor">#AA000000</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">2</item>
    </style>

    <style name="CC.Button.Secondary">
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/btn_secondary_text</item>
    </style>

    <style name="CC.Field">
        <item name="android:background">@drawable/field</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
