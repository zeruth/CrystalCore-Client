<?xml version="1.0" encoding="utf-8"?>
<!-- One patch of the update path: its version and size, a bar, what state it is in. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/patch_name"
            style="@style/CC.Mono"
            android:layout_width="0dp"
            android:layout_height="18dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="11.5sp"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeTextType="uniform"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="@color/text" />

        <TextView
            android:id="@+id/patch_state"
            style="@style/CC.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:singleLine="true"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/patch_size"
            style="@style/CC.Mono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:singleLine="true"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/patch_bar"
        style="@android:style/Widget.DeviceDefault.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="3dp"
        android:max="1000"
        android:progressDrawable="@drawable/progress_dual" />
</LinearLayout>
