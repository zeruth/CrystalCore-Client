<?xml version="1.0" encoding="utf-8"?>
<!-- The installer, in landscape: the crystal and the storage on the left, the patches in two columns
     on the right with the total, and the step under way and the buttons pinned beneath them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="10dp">

    <!-- ===== left: the crystal, the space ===== -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <include layout="@layout/cc_header" />

            <LinearLayout
                style="@style/CC.Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/CC.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_storage" />

                <View style="@style/CC.Rule" android:layout_marginTop="6dp" />

                <dev.crystalcore.client.SegmentBar
                    android:id="@+id/storage_bar"
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginTop="12dp" />

                <!-- (one line, the text shrinking to fit rather than wrapping) -->
                <TextView
                    android:id="@+id/storage_legend"
                    style="@style/CC.Small"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginTop="8dp"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeTextType="uniform"
                    android:maxLines="1" />

                <CheckBox
                    android:id="@+id/keep_downloads"
                    style="@style/CC.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:buttonTint="@color/gold"
                    android:text="@string/keep_downloads" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ===== right: the patches, the total, the work ===== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="18dp"
        android:layout_weight="3"
        android:orientation="vertical">

        <!-- (the panel takes what the pinned step leaves; only the patch columns scroll in it) -->
        <LinearLayout
            style="@style/CC.Panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CC.Heading"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/section_patches" />

                    <TextView
                        android:id="@+id/bar_key"
                        style="@style/CC.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp" />
                </LinearLayout>

                <View style="@style/CC.Rule" android:layout_marginTop="6dp" />

            </LinearLayout>

            <!-- (its scroll indicator out in the panel's own padding, clear of the second column) -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginEnd="-12dp"
                android:layout_weight="1"
                android:paddingEnd="12dp"
                android:scrollbarStyle="outsideOverlay">

                <!-- (the patches in two columns, filled down the first, then the second) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/patch_rows_a"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:id="@+id/patch_rows_b"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    style="@style/CC.Rule"
                    android:layout_marginTop="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CC.Heading"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/section_total"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/total_detail"
                        style="@style/CC.Mono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/total_bar"
                    style="@android:style/Widget.DeviceDefault.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="6dp"
                    android:max="1000"
                    android:progressDrawable="@drawable/progress_dual" />
            </LinearLayout>
        </LinearLayout>

        <!-- pinned: the step under way and the buttons -->
        <LinearLayout
            style="@style/CC.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <!-- the step and its numbers on one line, the one button that applies beside them
                 (Install or Continue while nothing runs, Stop while it does), the bar beneath -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/step"
                        style="@style/CC.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/gold_text" />

                    <TextView
                        android:id="@+id/detail"
                        style="@style/CC.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:singleLine="true" />
                </LinearLayout>

                <Button
                    android:id="@+id/stop"
                    style="@style/CC.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:minWidth="120dp"
                    android:minHeight="44dp"
                    android:text="@string/stop"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/install"
                    style="@style/CC.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:minWidth="140dp"
                    android:minHeight="44dp"
                    android:text="@string/install" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress"
                style="@android:style/Widget.DeviceDefault.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="10dp"
                android:indeterminateTint="@color/crystal"
                android:max="1000"
                android:progressDrawable="@drawable/progress_crystal" />

            <TextView
                android:id="@+id/message"
                style="@style/CC.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/warn"
                android:textIsSelectable="true"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
